        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 201\", function(){\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Cadastro deve ser realizado com sucesso\", function(){\r",
                  "    const response = pm.response.json();\r",
                  "    pm.expect(response.message).to.eql(\"Cadastro realizado com sucesso\");\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Response deve conter o ID do usuário\", function(){\r",
                  "    const response = pm.response.json();\r",
                  "    pm.expect(response).to.have.property(\"_id\");\r",
                  "    pm.expect(response._id).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "\r",
                  "// salva o _id no Environment selecionado.\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.environment.set(\"userId\", response._id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "/* Gerar Dados Dinâmicos para Testes de cadastro de usuários */\r",
                  "const timestamp = Date.now();\r",
                  "\r",
                  "pm.variables.set(\"newUserName\", `QA User ${timestamp}`);\r",
                  "pm.variables.set(\"newUserEmail\", `qa${timestamp}@example.com`);\r",
                  "pm.variables.set(\"newUserPassword\", \"SenhaTeste@123\");\r",
                  "pm.variables.set(\"newUserAdmin\", \"false\");\r",
                  "\r",
                  "console.log(\"newUserName\", pm.variables.get(\"newUserName\"));\r",
                  "console.log(\"newUserEmail\", pm.variables.get(\"newUserEmail\"));\r",
                  "console.log(\"newUserAdmin\", pm.variables.get(\"newUserAdmin\"))"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
