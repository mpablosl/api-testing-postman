        {
          "name": "Create Admin User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = Date.now();\r",
                  "\r",
                  "const adminName = `QA Admin ${timestamp}`;\r",
                  "const adminEmail = `qaadmin${timestamp}@example.com`;\r",
                  "const adminPassword = \"SenhaAdmin@123\";\r",
                  "\r",
                  "pm.environment.set(\"adminUserName\", adminName);\r",
                  "pm.environment.set(\"adminUserEmail\", adminEmail);\r",
                  "pm.environment.set(\"adminUserPassword\", adminPassword);\r",
                  "\r",
                  "console.log(\"Admin email:\", adminEmail);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser '201 Created'\", function(){\r",
                  "    pm.response.to.have.status(201);\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Mensagem de sucesso deve ser retornada\", function(){\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response.message).to.eql('Cadastro realizado com sucesso')\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Response deve conter ID\", function(){\r",
                  "\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response).to.have.property('_id');\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Propriedade Id deve ser string e não pode ser vazio\", function(){\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response._id).to.be.a('string').not.be.empty;\r",
                  "})"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
