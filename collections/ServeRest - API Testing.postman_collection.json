        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code deve ser 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response deve estar em formato JSON\", function () {\r\n    pm.response.to.be.json;\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Response deve conter authorization\", function () {\r\n    pm.expect(response).to.have.property(\"authorization\");\r\n    pm.expect(response.authorization)\r\n        .to.be.a(\"string\")\r\n        .and.not.empty;\r\n});\r\n\r\nconst authorization = response.authorization;\r\n\r\n// Remove \"Bearer \" caso a API o retorne junto com o token\r\nconst token = authorization.replace(/^Bearer\\s+/i, \"\");\r\n\r\npm.environment.set(\"authToken\", token);\r\n\r\nconsole.log(\"Token foi salvo:\", Boolean(token));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const timestamp = Date.now();\r\n\r\npm.variables.set(\"loginEmail\", `qaadmin${timestamp}@example.com`);\r\npm.variables.set(\"loginPassword\", \"SenhaAdmin@123\");\r\n\r\npm.environment.set(\r\n    \"adminUserEmail\",\r\n    pm.variables.get(\"adminUserEmail\")\r\n);\r\n\r\npm.environment.set(\r\n    \"adminUserPassword\",\r\n    pm.variables.get(\"adminUserPassword\")\r\n);\r\n\r\n\r\nconsole.log(\r\n    \"Email utilizado no login:\",\r\n    pm.environment.get(\"adminUserEmail\")\r\n);\r\n\r\nconsole.log(\r\n    \"Senha preenchida:\",\r\n    Boolean(pm.environment.get(\"adminUserPassword\"))\r\n);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
